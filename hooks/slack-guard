#!/usr/bin/env bash

readonly SCRIPT_NAME="slack-guard"
readonly ALLOWED_TOOLS=(
  "mcp__slack__slack_search_public"
  "mcp__slack__slack_search_public_and_private"
  "mcp__slack__slack_search_channels"
  "mcp__slack__slack_search_users"
  "mcp__slack__slack_search_emojis"
  "mcp__slack__slack_read_channel"
  "mcp__slack__slack_read_thread"
  "mcp__slack__slack_read_canvas"
  "mcp__slack__slack_read_file"
  "mcp__slack__slack_read_list"
  "mcp__slack__slack_read_user_profile"
  "mcp__slack__slack_list_user_channels"
  "mcp__slack__slack_list_channel_members"
  "mcp__slack__slack_get_reactions"
)

print_error() {
  local -r MESSAGE="$1"

  echo "${MESSAGE}" >&2
}

read_tool_name() {
  TOOL_NAME="$(jq -r '.tool_name')" || {
    print_error "${SCRIPT_NAME}: cannot read tool_name, blocking."
    exit 2
  }
}

is_allowed_tool() {
  local -r TOOL="$1"

  local allowed
  for allowed in "${ALLOWED_TOOLS[@]}"; do
    [[ "${TOOL}" == "${allowed}" ]] && return 0
  done

  return 1
}

main() {
  read_tool_name

  if is_allowed_tool "${TOOL_NAME}"; then
    exit 0
  fi

  print_error "${SCRIPT_NAME}: ${TOOL_NAME} blocked. Only read-only Slack tools allowed."
  exit 2
}

main "$@"
