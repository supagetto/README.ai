#!/usr/bin/env bash

readonly SCRIPT_NAME="slack-guard"
readonly INPUT="$(cat)"
readonly TOOL_NAME="$(jq -r '.tool_name // empty' <<<"${INPUT}")"

print_error() {
  local -r MESSAGE="$1"

  echo "${SCRIPT_NAME}: ${MESSAGE}" >&2
}

get_input() {
  local -r FILTER="$1"

  jq -r ".tool_input | ${FILTER}" <<<"${INPUT}"
}

is_destructive() {
  case "${TOOL_NAME}" in
    # Replaces the whole canvas, or deletes a section.
    mcp__slack__slack_update_canvas)
      [[ "$(get_input '.action')" == "replace" ]] \
        || get_input '.sections[]?.edit_type' | grep -qx "delete"
      ;;
    # Deletes list columns.
    mcp__slack__slack_update_list)
      [[ "$(get_input '.columns_to_delete // [] | length')" -gt 0 ]]
      ;;
    # Every other tool is allowed.
    *)
      return 1
      ;;
  esac
}

main() {
  if [[ -z "${TOOL_NAME}" ]]; then
    print_error "Cannot read tool name, blocking."
    exit 2
  fi

  if is_destructive; then
    print_error "\`${TOOL_NAME}\` blocked. Destructive Slack actions are not allowed."
    exit 2
  fi

  exit 0
}

main "$@"
