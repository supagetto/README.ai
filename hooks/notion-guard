#!/usr/bin/env bash

readonly SCRIPT_NAME="notion-guard"
readonly INPUT="$(cat)"
readonly TOOL_NAME="$(jq -r '.tool_name // empty' <<<"${INPUT}")"

print_error() {
  local -r MESSAGE="$1"

  echo "${SCRIPT_NAME}: ${MESSAGE}" >&2
}

get_input() {
  local -r FILTER="$1"

  jq -r ".tool_input | ${FILTER}" <<<"${INPUT}"
}

is_destructive() {
  case "${TOOL_NAME}" in
    # Erases the whole page.
    mcp__notion__notion-update-page)
      [[ "$(get_input '.command')" == "replace_content" ]]
      ;;
    # Moves the database to the trash.
    mcp__notion__notion-update-data-source)
      [[ "$(get_input '.in_trash')" == "true" ]]
      ;;
    # Removes files from the folder.
    mcp__notion__notion-update-folder)
      [[ "$(get_input '.command')" == "remove_files" ]]
      ;;
    # Every other tool is allowed.
    *)
      return 1
      ;;
  esac
}

main() {
  if [[ -z "${TOOL_NAME}" ]]; then
    print_error "Cannot read tool name, blocking."
    exit 2
  fi

  if is_destructive; then
    print_error "\`${TOOL_NAME}\` blocked. Destructive Notion actions are not allowed."
    exit 2
  fi

  exit 0
}

main "$@"
