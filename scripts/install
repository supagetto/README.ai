#!/usr/bin/env bash

# ┏━━━━━━━━━┓
# ┃ install ┃
# ┗━━━━━━━━━┛

readonly REPOSITORY_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly HOOK_NAMES=(
  "detect-skills-for-edit"
  "notion-guard"
  "skill-guard"
  "slack-guard"
)
readonly ESBUILD_VERSION="0.28.2"
readonly HOOK_SCRIPT_PACKAGE_PATHS=(
  "shared"
  "skill-detection"
)
readonly HOOK_SCRIPT_ENTRY_PATHS=(
  "skill-detection/detect-skills-for-edit.mjs"
  "skill-guard/skill-guard.mjs"
)

print() {
  local -r MESSAGE="$1"

  echo "${MESSAGE}"
}

print_error() {
  local -r ERROR_MESSAGE="$1"

  print "❌ ${ERROR_MESSAGE}" >&2
}

confirm_replacement() {
  local -r TARGET_PATH="$1"

  print "⚠️  Agents, rules, skills and hooks in \`${TARGET_PATH}\` with the same names as the ones in this repository will be replaced."

  local confirmation
  read -rp "❓ Continue? [y/N] " confirmation

  [[ "${confirmation}" == [yY] ]]
}

copy_skills() {
  local -r TARGET_PATH="$1"

  mkdir -p "${TARGET_PATH}/skills"

  local skill_path
  for skill_path in "${REPOSITORY_PATH}"/skills/*/; do
    local skill_name="$(basename "${skill_path}")"

    rm -rf "${TARGET_PATH}/skills/${skill_name}"
    cp -r "${skill_path}" "${TARGET_PATH}/skills/${skill_name}"
  done
}

copy_agents() {
  local -r TARGET_PATH="$1"

  mkdir -p "${TARGET_PATH}/agents"
  cp -f "${REPOSITORY_PATH}"/agents/*.md "${TARGET_PATH}/agents/"
}

copy_rules() {
  local -r TARGET_PATH="$1"

  mkdir -p "${TARGET_PATH}/rules"
  cp -f "${REPOSITORY_PATH}"/rules/*.md "${TARGET_PATH}/rules/"
}

copy_hooks() {
  local -r TARGET_PATH="$1"
  local -r SOURCE_SCRIPTS_PATH="${REPOSITORY_PATH}/hooks/scripts"
  local -r TARGET_SCRIPTS_PATH="${TARGET_PATH}/hooks/scripts"
  local -r DIST_PATH="${REPOSITORY_PATH}/dist"

  mkdir -p "${TARGET_PATH}/hooks"

  local hook_name
  for hook_name in "${HOOK_NAMES[@]}"; do
    cp -f "${REPOSITORY_PATH}/hooks/${hook_name}" "${TARGET_PATH}/hooks/${hook_name}"
  done

  local build_status=0
  local package_path

  for package_path in "${HOOK_SCRIPT_PACKAGE_PATHS[@]}"; do
    if ! pnpm install --silent --dir "${SOURCE_SCRIPTS_PATH}/${package_path}"; then
      print_error "Failed to install the \`${package_path}\` hook dependencies."
      build_status=1
      break
    fi
  done

  if [[ "${build_status}" -eq 0 ]]; then
    rm -rf "${DIST_PATH}"
    mkdir -p "${DIST_PATH}"

    local entry_path
    for entry_path in "${HOOK_SCRIPT_ENTRY_PATHS[@]}"; do
      if ! pnpm dlx "esbuild@${ESBUILD_VERSION}" "${SOURCE_SCRIPTS_PATH}/${entry_path}" \
        --bundle --platform=node --format=esm --log-level=warning \
        --banner:js="import { createRequire } from 'module'; const require = createRequire(import.meta.url);" \
        --outfile="${DIST_PATH}/$(basename "${entry_path}")"; then
        print_error "Failed to build \`${entry_path}\`."
        build_status=1
        break
      fi
    done
  fi

  if [[ "${build_status}" -eq 0 ]]; then
    rm -rf "${TARGET_SCRIPTS_PATH}"
    mkdir -p "${TARGET_SCRIPTS_PATH}"
    cp "${DIST_PATH}"/*.mjs "${TARGET_SCRIPTS_PATH}/"
  fi

  for package_path in "${HOOK_SCRIPT_PACKAGE_PATHS[@]}"; do
    rm -rf "${SOURCE_SCRIPTS_PATH}/${package_path}/node_modules"
  done

  return "${build_status}"
}

register_hooks() {
  local -r TARGET_PATH="$1"
  local -r HOOK_COMMAND_PREFIX="$2"
  local -r SETTINGS_PATH="${TARGET_PATH}/settings.json"

  if [[ ! -f "${SETTINGS_PATH}" ]]; then
    echo "{}" >"${SETTINGS_PATH}"
  fi

  local -r UPDATED_SETTINGS="$(jq --arg prefix "${HOOK_COMMAND_PREFIX}" '
    def set_hook(event; matcher; command):
      .hooks[event] = (
        ((.hooks[event] // []) | map(select(any(.hooks[]?; .command == command) | not)))
        + [({ hooks: [{ type: "command", command: command }] }
            + (if matcher == "" then {} else { matcher: matcher } end))]
      );

    set_hook("PreToolUse"; "Edit|Write|MultiEdit"; "\($prefix)/detect-skills-for-edit")
    | set_hook("PreToolUse"; "Skill"; "\($prefix)/skill-guard")
    | set_hook("PreToolUse"; "mcp__notion__.*"; "\($prefix)/notion-guard")
    | set_hook("PreToolUse"; "mcp__slack__.*"; "\($prefix)/slack-guard")
  ' "${SETTINGS_PATH}")"

  if [[ -z "${UPDATED_SETTINGS}" ]]; then
    print_error "Failed to update \`${SETTINGS_PATH}\`."
    return 1
  fi

  echo "${UPDATED_SETTINGS}" >"${SETTINGS_PATH}"
}

install() {
  local -r TARGET_PATH="$1"
  local -r HOOK_COMMAND_PREFIX="$2"

  if ! confirm_replacement "${TARGET_PATH}"; then
    print "🚫 Installation cancelled."
    return
  fi

  copy_agents "${TARGET_PATH}"
  copy_rules "${TARGET_PATH}"
  copy_skills "${TARGET_PATH}"

  if ! copy_hooks "${TARGET_PATH}"; then
    return 1
  fi

  if ! register_hooks "${TARGET_PATH}" "${HOOK_COMMAND_PREFIX}"; then
    return 1
  fi

  print "✅ Agents, rules, skills and hooks installed to \`${TARGET_PATH}\`."
}

install_personal() {
  if [[ "$#" -ne 0 ]]; then
    print_error "Invalid \`$1\` argument."
    return 1
  fi

  install "${HOME}/.claude" "${HOME}/.claude/hooks"
}

install_project() {
  local -r PROJECT_PATH="${1:-${PWD}}"

  if [[ "$#" -gt 1 ]]; then
    print_error "Invalid \`$2\` argument."
    return 1
  fi

  if [[ ! -d "${PROJECT_PATH}" ]]; then
    print_error "Directory \`${PROJECT_PATH}\` does not exist."
    return 1
  fi

  install "$(cd "${PROJECT_PATH}" && pwd)/.claude" "\$CLAUDE_PROJECT_DIR/.claude/hooks"
}

handle_level() {
  case "$1" in
    personal)
      shift
      install_personal "$@"
      return
      ;;
    project)
      shift
      install_project "$@"
      return
      ;;
    *)
      print_error "Invalid \`$1\` level."
      return 1
      ;;
  esac
}

choose_level() {
  echo "1) 👤 personal"
  echo "2) 📁 project"

  local choice
  read -rp "📦 Install level [1/2]: " choice

  case "${choice}" in
    1)
      install_personal
      return
      ;;
    2)
      local project_path
      read -rp "📂 Project path [${PWD}]: " project_path

      install_project "${project_path:-${PWD}}"
      return
      ;;
    *)
      print_error "Invalid \`${choice}\` level."
      return 1
      ;;
  esac
}

main() {
  if [[ -n "$1" ]]; then
    handle_level "$@"
    exit
  fi

  choose_level
}

main "$@"
