#!/usr/bin/env bash
set -euo pipefail

readonly SCRIPT_NAME="$(basename "$0")"
readonly CACHE_ROOT="${XDG_CACHE_HOME:-${HOME}/.cache}/borrowed-skills"

main() {
  if [[ $# -ne 2 ]]; then
    echo "usage: ${SCRIPT_NAME} <owner>/<repo> <commit-sha>" >&2
    exit 2
  fi

  local -r repository="$1"
  local -r commit_sha="$2"
  local -r clone_directory="${CACHE_ROOT}/${repository/\//_}_${commit_sha}"

  if [[ -d "${clone_directory}" ]]; then
    echo "${clone_directory}"
    exit 0
  fi

  mkdir -p "${CACHE_ROOT}"
  local -r temporary_directory="$(mktemp -d "${CACHE_ROOT}/.tmp.XXXXXX")"

  git -C "${temporary_directory}" init -q
  git -C "${temporary_directory}" fetch -q --depth 1 "https://github.com/${repository}" "${commit_sha}"
  git -C "${temporary_directory}" checkout -q FETCH_HEAD
  mv "${temporary_directory}" "${clone_directory}"

  echo "${clone_directory}"
}

main "$@"
