#!/usr/bin/env bash
set -euo pipefail

readonly SKILL_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly OXLINT_VERSION="1.95.0"
readonly OXLINT_TSGOLINT_VERSION="7.0.2008"

main() {
  npx -y -p "oxlint@${OXLINT_VERSION}" -p "oxlint-tsgolint@${OXLINT_TSGOLINT_VERSION}" \
    oxlint --type-aware --config "${SKILL_PATH}/oxlintrc.json" "$@"
}

main "$@"
